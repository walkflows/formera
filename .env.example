# Optional. Used only to build absolute URLs in sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# n8n WF01 enquiry webhook. Server-side only: do not prefix with NEXT_PUBLIC_.
WF01_WEBHOOK_URL=
WF01_WEBHOOK_SECRET=

# Supabase project used to create and check enquiry sessions. Server-side only.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: never prefix it with
# NEXT_PUBLIC_, never log it, and never commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
